{
  "name": "Blood Donation Project",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "runArgs": ["--network", "blood-donation-network"],
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "source=/home/${localEnv:USER}/.gitconfig,target=/root/.gitconfig,type=bind" // Mount host Git config
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "dsznajder.es7-react-js-snippets",
        "dbaeumer.vscode-eslint",
        "eamodio.gitlens",
        "visualstudioexptteam.vscodeintellicode",
        "christian-kohler.npm-intellisense",
        "vscjava.vscode-java-dependency",
        "postman.postman-for-vscode"
      ]
    }
  },
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopContainer",
  "containerEnv": {
    "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk",
    "NODE_ENV": "development"
  },
  "forwardPorts": [5173, 8080, 3306],
  "postCreateCommand": "bash /workspace/.devcontainer/setup-git.sh" // Run Git setup script
}
